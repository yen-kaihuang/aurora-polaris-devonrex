---
// src/components/Footer.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="footer-section">
  <!-- "Contact Us" 標題在淺色背景區，波浪上方 -->
  <h2 class="contact-heading">{t('home.contactTitle')}</h2>

  <footer class="site-footer">
    <img src="/images/home/wave-footer.svg" alt="" class="footer-wave" aria-hidden="true" />

    <div class="footer-body">
      <div class="contact-wrap">
        <img src="/images/home/contact-circle.svg" alt="" class="contact-circle" aria-hidden="true" />
        <ul class="contact-list">
          <li><a href={`mailto:${t('home.email')}`}>Email: {t('home.email')}</a></li>
          <li>Instagram: {t('home.instagram')}</li>
          <li>Facebook: {t('home.facebook')}</li>
          <li>WeChat: {t('home.wechat')}</li>
        </ul>
      </div>

      <div class="footer-copy">
        <p>{t('home.copyright1')}</p>
        <p>{t('home.copyright2')}</p>
      </div>
    </div>

    <div class="paw-row" aria-hidden="true">
      <img src="/images/home/paw-1.png" alt="" />
      <img src="/images/home/paw-2.png" alt="" />
      <img src="/images/home/paw-1.png" alt="" />
      <img src="/images/home/paw-2.png" alt="" />
      <img src="/images/home/paw-1.png" alt="" />
      <img src="/images/home/paw-2.png" alt="" />
    </div>
  </footer>
</section>

<style>
  /* 淺色包覆區（含標題） */
  .footer-section {
    background-color: var(--color-bg);
    font-family: var(--font-brand);
  }

  .contact-heading {
    font-size: clamp(40px, 5vw, 64px);
    color: var(--color-text);
    text-align: center;
    padding: 60px 80px 40px;
  }

  /* 深色 footer 本體 */
  .site-footer {
    background-color: var(--color-bg-dark);
    color: var(--color-text);
  }

  .footer-wave {
    width: 100%;
    display: block;
    margin-bottom: -4px;
  }

  .footer-body {
    padding: 60px 80px 40px;
  }

  /* 聯絡資訊 + 圓圈裝飾 */
  .contact-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: 40px;
  }

  .contact-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 140%;
    opacity: 0.45;
    pointer-events: none;
  }

  .contact-list {
    position: relative;
    z-index: 1;
    font-size: 20px;
    line-height: 2;
  }

  .contact-list a {
    transition: opacity 0.2s;
  }

  .contact-list a:hover {
    opacity: 0.7;
  }

  /* 版權 */
  .footer-copy {
    text-align: center;
    font-size: 13px;
    opacity: 0.65;
    line-height: 1.8;
  }

  /* 爪印 */
  .paw-row {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 20px 40px 12px;
  }

  .paw-row img {
    width: 72px;
    height: auto;
    opacity: 0.55;
  }
</style>
