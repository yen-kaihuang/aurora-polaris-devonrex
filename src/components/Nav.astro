---
// src/components/Nav.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = `/${lang}`;

const links = [
  { href: `${base}/`, label: t('nav.home') },
  { href: `${base}/litters`, label: t('nav.litters') },
  { href: `${base}/kings-and-queens`, label: t('nav.kingsQueens') },
  { href: `${base}/available-kittens`, label: t('nav.availableKittens') },
  { href: `${base}/about-cattery`, label: t('nav.aboutCattery') },
  { href: `${base}/about-devon-rex`, label: t('nav.aboutDevonRex') },
  { href: `${base}/shipping`, label: t('nav.shipping') },
  { href: `${base}/adoption-questionnaire`, label: t('nav.adoption') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="site-header">
  <a class="site-logo" href={`${base}/`} aria-label={t('site.name')}>
    <img src="/images/d/logo.png" alt={t('site.name')} />
  </a>
  <div class="header-right">
    <nav aria-label="Main">
      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <LangSwitcher />
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(14px, 1.6vw, 24px);
    padding: 12px clamp(20px, 3vw, 48px);
    background: transparent;
    font-family: var(--font-brand);
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .site-logo img {
    height: clamp(56px, 6vw, 88px);
    width: auto;
    display: block;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.6vw, 24px);
    min-width: 0;
  }

  .nav-links {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(10px, 1.5vw, 22px);
    font-size: clamp(13px, 1.05vw, 16px);
  }

  .nav-links li {
    white-space: nowrap;
  }

  .nav-links a {
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 0.55;
  }

  /* On small screens, shrink logo and allow nav to scroll horizontally */
  @media (max-width: 820px) {
    .site-header {
      gap: 12px;
      padding: 10px 16px;
    }
    .site-logo img {
      height: 44px;
    }
    .header-right {
      min-width: 0;
      flex: 1;
    }
    .nav-links {
      justify-content: flex-end;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      min-width: 0;
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }
  }
</style>
