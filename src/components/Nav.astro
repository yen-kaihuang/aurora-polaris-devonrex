---
// src/components/Nav.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = `/${lang}`;

const links = [
  { href: `${base}/`, label: t('nav.home') },
  { href: `${base}/litters`, label: t('nav.litters') },
  { href: `${base}/kings-and-queens`, label: t('nav.kingsQueens') },
  { href: `${base}/available-kittens`, label: t('nav.availableKittens') },
  { href: `${base}/about-cattery`, label: t('nav.aboutCattery') },
  { href: `${base}/about-devon-rex`, label: t('nav.aboutDevonRex') },
  { href: '#', label: t('nav.shipping') },
  { href: '#', label: t('nav.adoption') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="site-header">
  <a class="site-logo" href={`${base}/`}>Aurora Polaris<br />Devon Rex</a>
  <nav aria-label="Main">
    <ul class="nav-links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
  <LangSwitcher />
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(14px, 1.6vw, 24px);
    padding: 22px clamp(20px, 3vw, 48px);
    background: transparent;
    font-family: var(--font-brand);
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-logo {
    font-size: 13px;
    line-height: 1.25;
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .nav-links {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1.5vw, 22px);
    font-size: clamp(13px, 1.05vw, 16px);
    flex: 1;
    min-width: 0;
  }

  .nav-links li {
    white-space: nowrap;
  }

  .nav-links a {
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 0.55;
  }

  /* On small screens, allow horizontal scroll instead of wrapping */
  @media (max-width: 820px) {
    .site-header {
      gap: 12px;
      padding: 16px 16px;
    }
    .nav-links {
      justify-content: flex-start;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }
  }
</style>
