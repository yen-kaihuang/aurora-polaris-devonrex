---
// src/components/ShippingInfo.astro
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="shipping">
  <header class="shipping-hero">
    <h1>{t('shipping.heroTitle')}</h1>
    <p>{t('shipping.intro')}</p>
  </header>

  <div class="shipping-methods">

    <!-- Method 1: Vancouver BC -->
    <div class="method-card">
      <span class="method-number">#1</span>
      <h2 class="method-title">{t('shipping.m1.title')}</h2>
      <div class="method-body">
        <p class="method-area">{t('shipping.m1.area')}</p>
        <p>{t('shipping.m1.body')}</p>
      </div>
    </div>

    <!-- Method 2: Vancouver Island -->
    <div class="method-card">
      <span class="method-number">#2</span>
      <h2 class="method-title">{t('shipping.m2.title')}</h2>
      <div class="method-body">
        <dl class="sub-options">
          <dt>{t('shipping.m2.opt1Label')}</dt>
          <dd>{t('shipping.m2.opt1Body')}</dd>
          <dt>{t('shipping.m2.opt2Label')}</dt>
          <dd>{t('shipping.m2.opt2Body')}</dd>
        </dl>
      </div>
    </div>

    <!-- Method 3: Domestic Canada -->
    <div class="method-card">
      <span class="method-number">#3</span>
      <h2 class="method-title">{t('shipping.m3.title')}</h2>
      <div class="method-body">
        <p>{t('shipping.m3.body')}</p>
      </div>
    </div>

    <!-- Method 4: International -->
    <div class="method-card">
      <span class="method-number">#4</span>
      <h2 class="method-title">{t('shipping.m4.title')}</h2>
      <div class="method-body">
        <p>{t('shipping.m4.body')}</p>
        <p class="fee-note">{t('shipping.m4.feeNote')}</p>
      </div>
    </div>

  </div>
</section>

<style>
  .shipping {
    background: var(--color-bg);
    font-family: var(--font-brand);
    padding: clamp(140px, 16vw, 220px) var(--page-pad) clamp(60px, 8vw, 110px);
  }

  /* Hero */
  .shipping-hero {
    max-width: 880px;
    margin: 0 auto clamp(40px, 5vw, 72px);
    text-align: center;
  }

  .shipping-hero h1 {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(38px, 5.5vw, 64px);
    color: var(--color-text);
    margin-bottom: clamp(18px, 2.5vw, 28px);
  }

  .shipping-hero p {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.7;
    color: var(--color-text);
    opacity: 0.7;
  }

  /* Methods grid */
  .shipping-methods {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  /* Individual card */
  .method-card {
    position: relative;
    background: var(--color-band-soft);
    padding: clamp(28px, 4vw, 56px) clamp(28px, 4vw, 56px) clamp(28px, 4vw, 56px) clamp(60px, 7vw, 100px);
    border-radius: 4px;
    overflow: hidden;
  }

  /* Watermark number */
  .method-number {
    position: absolute;
    top: clamp(8px, 1.2vw, 16px);
    left: clamp(12px, 1.6vw, 24px);
    font-size: clamp(48px, 6vw, 80px);
    font-family: var(--font-brand);
    font-weight: normal;
    color: rgba(83, 86, 92, 0.15);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .method-title {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(18px, 1.8vw, 24px);
    color: var(--color-text);
    margin-bottom: clamp(12px, 1.4vw, 20px);
  }

  .method-body {
    font-size: clamp(15px, 1.2vw, 17px);
    color: var(--color-text);
    line-height: 1.7;
  }

  .method-body p + p {
    margin-top: 10px;
  }

  .method-area {
    opacity: 0.7;
    font-size: clamp(14px, 1.1vw, 16px);
    margin-bottom: 8px;
  }

  /* Vancouver Island sub-options */
  .sub-options {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sub-options dt {
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .sub-options dd {
    margin-left: clamp(12px, 1.6vw, 24px);
    opacity: 0.8;
  }

  /* International fee note */
  .fee-note {
    margin-top: 10px;
    font-size: clamp(13px, 1vw, 15px);
    opacity: 0.65;
  }
</style>
