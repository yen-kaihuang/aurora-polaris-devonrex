---
// src/components/LangSwitcher.astro
import { getLangFromUrl } from '../i18n/utils';
import { languages } from '../i18n/ui';

const current = getLangFromUrl(Astro.url);
const rest = Astro.url.pathname.replace(/^\/(en|zh)/, '') || '/';
---

<nav aria-label="Language" class="lang-switcher">
  <ul>
    {Object.entries(languages).map(([code, label]) => (
      <li>
        {code === current
          ? <span aria-current="true">{label}</span>
          : <a href={`/${code}${rest}`}>{label}</a>}
      </li>
    ))}
  </ul>
</nav>

<style>
  .lang-switcher ul {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    white-space: nowrap;
  }

  .lang-switcher span[aria-current] {
    opacity: 0.45;
    font-size: 14px;
  }

  .lang-switcher a {
    transition: opacity 0.2s;
  }

  .lang-switcher a:hover {
    opacity: 0.6;
  }
</style>
