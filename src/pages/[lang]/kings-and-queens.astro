---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatProfile from '../../components/CatProfile.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const b = '/images/d/kq';

const kings = [
  { name: 'Elijah', color: 'Green Yellow-Eyed White', main: `${b}/elijah-main.png`, thumbs: [`${b}/elijah-1.png`, `${b}/elijah-2.png`, `${b}/elijah-3.png`] },
  { name: 'Richard', color: 'Red with White Spots', main: `${b}/richard-main.png`, thumbs: [`${b}/richard-1.png`, `${b}/richard-2.png`, `${b}/richard-3.png`] },
  { name: 'Rio', color: 'Cream Bicolor', main: `${b}/rio-main.png`, thumbs: [`${b}/rio-1.png`, `${b}/rio-2.png`] },
];

const queens = [
  { name: 'Vivian', color: 'Odd-Eyed White', main: `${b}/vivian-main.png`, thumbs: [`${b}/vivian-1.png`, `${b}/vivian-2.png`, `${b}/vivian-3.png`] },
  { name: 'Vanda', color: 'Black Classic Tabby Bicolor', main: `${b}/vanda-main.png`, thumbs: [`${b}/vanda-1.png`, `${b}/vanda-2.png`, `${b}/vanda-3.png`] },
  { name: 'Persimona', color: 'Red Classic Tabby', main: `${b}/persimona-main.png`, thumbs: [`${b}/persimona-1.png`, `${b}/persimona-2.png`, `${b}/persimona-3.png`] },
  { name: 'Arya', color: 'Blue-Eyed White', main: `${b}/arya-main.png`, thumbs: [`${b}/arya-1.png`, `${b}/arya-2.png`, `${b}/arya-3.png`] },
  { name: 'Arina', color: 'Lavender Lynx Pointed-White', main: `${b}/arina-main.png`, thumbs: [`${b}/arina-1.png`, `${b}/arina-2.png`, `${b}/arina-3.png`] },
  { name: 'Caroline', color: 'Pure Black', main: `${b}/caroline-main.png`, thumbs: [`${b}/caroline-1.png`, `${b}/caroline-2.png`, `${b}/caroline-3.png`] },
];

const bloodType = 'A/b';
const labelColor = t('kq.labelColor');
const labelBlood = t('kq.labelBlood');
---

<BaseLayout title={t('kq.title')}>
  <div class="page-kq">
    <header class="kq-intro">
      <h1 class="kq-intro-title">{t('kq.introTitle')}</h1>
      <p class="prose kq-intro-body">{t('kq.intro')}</p>
    </header>

    <section class="kq-group">
      <h2 class="kq-group-title">{t('kq.ourKings')}</h2>
      <div class="kq-list">
        {kings.map((cat, i) => (
          <CatProfile {...cat} bloodType={bloodType} side={i % 2 === 0 ? 'left' : 'right'} labelColor={labelColor} labelBlood={labelBlood} />
        ))}
      </div>
    </section>

    <section class="kq-group">
      <h2 class="kq-group-title">{t('kq.ourQueens')}</h2>
      <div class="kq-list">
        {queens.map((cat, i) => (
          <CatProfile {...cat} bloodType={bloodType} side={i % 2 === 0 ? 'right' : 'left'} labelColor={labelColor} labelBlood={labelBlood} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-kq {
    background: var(--color-bg);
    font-family: var(--font-brand);
  }

  .kq-intro {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(140px, 16vw, 220px) var(--page-pad) clamp(20px, 3vw, 40px);
    text-align: center;
  }

  .kq-intro-title {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .kq-intro-body {
    text-align: center;
  }

  .kq-group {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 90px) var(--page-pad);
  }

  .kq-group-title {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(36px, 5vw, 64px);
    color: var(--color-text);
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .kq-list {
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 8vw, 110px);
  }
</style>
