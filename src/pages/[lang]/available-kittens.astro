---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('kittens.title')}>
  <div class="page-kittens">
    <img class="kittens-bg" src="/images/d/kittens-bg.jpg" alt="" aria-hidden="true" />
    <div class="kittens-veil" aria-hidden="true"></div>
    <section class="kittens-content">
      <h1 class="kittens-heading">{t('kittens.title')}</h1>
      <p class="prose kittens-body">{t('kittens.body')}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-kittens {
    position: relative;
    min-height: 100vh;
    font-family: var(--font-brand);
    overflow: hidden;
    background: var(--color-bg);
  }

  .kittens-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
  }

  .kittens-veil {
    position: absolute;
    inset: 0;
    background: rgba(234, 224, 215, 0.55);
  }

  .kittens-content {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(160px, 20vw, 280px) var(--page-pad) clamp(120px, 16vw, 220px);
    text-align: center;
  }

  .kittens-heading {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(40px, 5.5vw, 64px);
    color: var(--color-text);
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .kittens-body {
    text-align: center;
    max-width: 940px;
    margin: 0 auto;
  }
</style>
