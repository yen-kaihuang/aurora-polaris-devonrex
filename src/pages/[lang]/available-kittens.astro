---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KittenCard from '../../components/KittenCard.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { sanityClient } from '../../lib/sanity/client';
import { allAvailableKittensQuery, type AvailableKitten } from '../../lib/sanity/queries';
import { urlFor } from '../../lib/sanity/imageUrl';
import { formatBirthday } from '../../lib/format/date';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const kittens = await sanityClient.fetch<AvailableKitten[]>(allAvailableKittensQuery);

const labels = {
  color: t('litters.kColor'),
  sex: t('litters.kSex'),
  born: t('litters.kBorn'),
  status: t('litters.kStatus'),
  blood: t('litters.kBlood'),
  location: t('litters.kLocation'),
};

function toCard(k: AvailableKitten) {
  const [main, ...rest] = k.photos;
  return {
    name: lang === 'zh' ? (k.nameZh || k.nameEn) : k.nameEn,
    color: k.color ?? '',
    sex: k.gender === 'male' ? t('kittens.sexMale') : t('kittens.sexFemale'),
    born: formatBirthday(k.birthday, lang),
    status: k.status === 'available' ? t('kittens.statusAvailable') : t('kittens.statusReserved'),
    location: t('kittens.location'),
    bloodType: t('kittens.bloodType'),
    mainUrl: urlFor(main).width(700).url(),
    thumbUrls: rest.slice(0, 3).map((p) => urlFor(p).width(300).url()),
  };
}

const cards = kittens.map(toCard);
---

<BaseLayout title={t('kittens.title')}>
  <div class="page-kittens">
    {cards.length === 0 ? (
      <header class="kittens-hero">
        <img class="kittens-bg" src="/images/d/kittens-bg.jpg" alt="" aria-hidden="true" />
        <div class="kittens-veil" aria-hidden="true"></div>
        <section class="kittens-content">
          <h1 class="kittens-heading">{t('kittens.title')}</h1>
          <p class="kittens-tagline">{t('kittens.tagline')}</p>
          <p class="prose kittens-body">{t('kittens.body')}</p>
        </section>
      </header>
    ) : (
      <section class="kittens-list">
        <h1 class="kittens-list-title">{t('kittens.recentTitle')}</h1>
        <div class="kittens-list-grid">
          {cards.map((c) => (
            <KittenCard {...c} labels={labels} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .page-kittens {
    font-family: var(--font-brand);
    background: var(--color-bg);
  }

  /* Hero ---------------------------------------------------------------- */
  .kittens-hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .kittens-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
  }

  .kittens-veil {
    position: absolute;
    inset: 0;
    background: rgba(234, 224, 215, 0.55);
  }

  .kittens-content {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(160px, 20vw, 280px) var(--page-pad) clamp(120px, 16vw, 220px);
    text-align: center;
  }

  .kittens-heading {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(40px, 5.5vw, 64px);
    color: var(--color-text);
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .kittens-tagline {
    font-size: clamp(18px, 2vw, 26px);
    color: var(--color-text);
    font-style: italic;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .kittens-body {
    text-align: center;
    max-width: 940px;
    margin: 0 auto;
  }

  /* List ---------------------------------------------------------------- */
  .kittens-list {
    padding: clamp(140px, 16vw, 220px) var(--page-pad) clamp(60px, 8vw, 110px);
  }

  .kittens-list-title {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(36px, 5vw, 64px);
    color: var(--color-text);
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .kittens-list-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 90px);
  }
</style>
