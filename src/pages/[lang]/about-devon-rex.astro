---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const facts = [
  { title: t('drx.charTitle'), body: t('drx.charBody') },
  { title: t('drx.feedTitle'), body: t('drx.feedBody') },
  { title: t('drx.distinguishTitle'), body: t('drx.distinguishBody') },
  { title: t('drx.shedTitle'), body: t('drx.shedBody') },
];
---

<BaseLayout title={t('drx.heroTitle')}>
  <div class="page-drx">
    <!-- Hero -->
    <section class="drx-hero">
      <img src="/images/d/drx-hero.png" alt="Devon Rex cat" class="drx-hero-img" />
      <div class="drx-hero-text">
        <h1>About<br />Devon Rex</h1>
      </div>
    </section>

    <p class="drx-subtitle">{t('drx.subtitle')}</p>

    <!-- Origin -->
    <section class="drx-section">
      <div class="card-stack card-stack--left">
        <div class="card-front">
          <h2 class="section-label">{t('drx.originTitle')}</h2>
          <div class="card-body">
            <p>{t('drx.originBody')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- More Facts -->
    <section class="drx-section drx-section--facts">
      <div class="card-stack card-stack--right">
        <div class="card-front">
          <h2 class="section-label">{t('drx.moreTitle')}</h2>
          <div class="facts-list">
            {facts.map((fact) => (
              <div class="fact">
                <h3 class="fact-title">{fact.title}</h3>
                <p class="fact-body">{fact.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-drx {
    background-color: var(--color-band);
    font-family: var(--font-brand);
  }

  /* Hero */
  .drx-hero {
    position: relative;
    height: clamp(400px, 47.9vw, 690px);
    overflow: hidden;
  }

  .drx-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .drx-hero-text {
    position: absolute;
    bottom: clamp(40px, 9vw, 130px);
    left: var(--page-pad);
    color: #fff;
  }

  .drx-hero-text h1 {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(36px, 4.4vw, 64px);
    line-height: 1.15;
    color: #fff;
  }

  .drx-subtitle {
    font-size: clamp(24px, 2.8vw, 40px);
    color: #fff;
    text-align: center;
    padding: clamp(40px, 5vw, 70px) var(--page-pad) clamp(28px, 3.5vw, 48px);
  }

  /* Sections */
  .drx-section {
    padding: 0 var(--page-pad) clamp(56px, 7vw, 90px);
  }

  .card-stack {
    position: relative;
    max-width: 1081px;
    margin: 0 auto;
  }

  .card-stack--left::before {
    content: '';
    position: absolute;
    top: -48px;
    left: -28px;
    width: 100%;
    height: 100%;
    background: rgba(220, 204, 194, 0.73);
    z-index: 0;
  }

  .card-stack--right::before {
    content: '';
    position: absolute;
    top: -53px;
    right: -45px;
    width: 100%;
    height: 100%;
    background: #dcccc2;
    z-index: 0;
  }

  .card-front {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.51);
    padding: clamp(36px, 4vw, 56px) clamp(28px, 5vw, 72px);
  }

  .section-label {
    font-size: clamp(18px, 1.6vw, 22px);
    color: rgba(83, 86, 92, 0.85);
    text-align: center;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .card-body {
    font-size: clamp(16px, 1.25vw, 20px);
    color: var(--color-text-light);
    text-align: justify;
    line-height: 1.8;
  }

  /* Facts */
  .facts-list {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3.5vw, 44px);
  }

  .fact-title {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(18px, 1.5vw, 20px);
    color: #000;
    text-align: center;
    margin-bottom: 14px;
  }

  .fact-body {
    font-size: clamp(16px, 1.25vw, 20px);
    color: rgba(83, 86, 92, 0.85);
    line-height: 1.8;
    text-align: justify;
  }
</style>
