---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('cattery.heroTitle')}>
  <div class="page-cattery">
    <!-- Hero：標題在左下角 -->
    <section class="cattery-hero">
      <img src="/images/about-cattery/hero.jpg" alt="Our cattery" class="cattery-hero-img" />
      <div class="cattery-hero-text">
        <h1>About<br />Our Cattery</h1>
      </div>
    </section>

    <!-- 副標題：英雄下方淡色區 -->
    <p class="cattery-subtitle">{t('cattery.subtitle')}</p>

    <!-- Section 1：貓舍介紹，accent 卡片從左上角透出 -->
    <section class="cattery-section">
      <div class="card-stack card-stack--left">
        <div class="card-front">
          <h2 class="section-label">{t('cattery.section1Title')}</h2>
          <div class="card-body">
            {t('cattery.body1').split('\n\n').map((para: string) => (
              <p>{para}</p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2：飲食，accent 卡片從右上角透出 -->
    <section class="cattery-section cattery-section--diet">
      <div class="card-stack card-stack--right">
        <div class="card-front">
          <h2 class="section-label">{t('cattery.section2Title')}</h2>
          <div class="card-body card-body--dark">
            {t('cattery.body2').split('\n\n').map((para: string) => (
              <p>{para}</p>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-cattery {
    background-color: var(--color-bg-dark);
    font-family: var(--font-brand);
  }

  /* Hero */
  .cattery-hero {
    position: relative;
    height: clamp(400px, 49.5vw, 713px);
    overflow: hidden;
  }

  .cattery-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .cattery-hero-text {
    position: absolute;
    bottom: 80px;
    left: 80px;
    color: white;
  }

  .cattery-hero-text h1 {
    font-family: var(--font-brand);
    font-size: clamp(36px, 4.4vw, 64px);
    line-height: 1.1;
    color: white;
  }

  /* 副標題 */
  .cattery-subtitle {
    font-size: clamp(22px, 2.8vw, 40px);
    color: var(--color-text-light);
    text-align: center;
    padding: 52px 80px 48px;
  }

  /* Sections */
  .cattery-section {
    padding: 48px 80px 80px;
  }

  .cattery-section--diet {
    padding-top: 0;
  }

  /* 雙層疊放卡片 */
  .card-stack {
    position: relative;
    max-width: 1081px;
    margin: 0 auto;
  }

  /* accent 卡片：左上角透出 */
  .card-stack--left::before {
    content: '';
    position: absolute;
    top: -48px;
    left: -28px;
    width: 100%;
    height: 100%;
    background: rgba(220, 204, 194, 0.73);
    z-index: 0;
  }

  /* accent 卡片：右上角透出 */
  .card-stack--right::before {
    content: '';
    position: absolute;
    top: -53px;
    right: -45px;
    width: 100%;
    height: 100%;
    background: #dcccc2;
    z-index: 0;
  }

  .card-front {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.51);
    padding: 48px 72px;
  }

  .section-label {
    font-size: 20px;
    color: rgba(83, 86, 92, 0.79);
    text-align: center;
    margin-bottom: 36px;
  }

  .card-body {
    font-size: 20px;
    color: var(--color-text-light);
    text-align: center;
    line-height: 1.75;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-body--dark {
    color: rgba(83, 86, 92, 0.79);
  }
</style>
