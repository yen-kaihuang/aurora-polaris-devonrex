---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { sanityClient } from '../../lib/sanity/client';
import { allAvailableKittensQuery, type AvailableKitten } from '../../lib/sanity/queries';
import { urlFor } from '../../lib/sanity/imageUrl';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = `/${lang}`;

const welcomeBody = t('home.welcomeBody').split('\n\n');

const kittens = await sanityClient.fetch<AvailableKitten[]>(allAvailableKittensQuery);
const kittenThumbs = kittens.map((k) => ({
  src: urlFor(k.photos[0]).width(500).url(),
  alt: lang === 'zh' ? (k.nameZh || k.nameEn) : k.nameEn,
}));

const partnerLogos = [
  '/images/d/logo-1.png',
  '/images/d/logo-2.png',
  '/images/d/logo-3.png',
  '/images/d/logo-4.png',
];
---

<BaseLayout title={t('site.name')}>
  <!-- Hero -->
  <section class="hero">
    <img class="hero-cats" src="/images/d/hero-cats.png" alt="A group of Devon Rex cats" />
    <h1 class="hero-title">Aurora Polaris<br />Devon Rex</h1>
  </section>

  <!-- Welcome -->
  <section class="welcome">
    <div class="welcome-inner">
      <div class="welcome-photo">
        <img src="/images/d/welcome-cats.png" alt="Two Devon Rex cats framed by lavender" />
      </div>
      <div class="welcome-text">
        <p class="welcome-eyebrow">{t('home.welcomeLabel')}</p>
        <h2 class="welcome-title">{t('home.welcomeTitle')}</h2>
        <div class="prose welcome-body">
          {welcomeBody.map((para: string) => <p>{para}</p>)}
        </div>
        <a class="btn" href={`${base}/about-cattery`}>{t('common.learnMore')}</a>
      </div>
    </div>
  </section>

  <!-- Available kittens -->
  {kittenThumbs.length > 0 && (
    <section class="kittens">
      <h2 class="section-title kittens-title">{t('home.kittensTitle')}</h2>
      <div class="kittens-row">
        <div class="kittens-grid" data-kittens-grid data-count={kittenThumbs.length}>
          {kittenThumbs.map((k) => (
            <img src={k.src} alt={k.alt} />
          ))}
        </div>
        {kittenThumbs.length > 3 && (
          <button
            type="button"
            class="kittens-arrow"
            data-kittens-arrow
            aria-label={lang === 'zh' ? '下一張' : 'Next'}
          >
            <img src="/images/d/kittens-deco.png" alt="" aria-hidden="true" />
          </button>
        )}
      </div>
      <div class="kittens-cta">
        <a class="btn" href={`${base}/available-kittens`}>{t('common.learnMore')}</a>
      </div>
    </section>
  )}

  <script>
    const grid = document.querySelector<HTMLElement>('[data-kittens-grid]');
    const arrow = document.querySelector<HTMLButtonElement>('[data-kittens-arrow]');
    if (grid && arrow) {
      arrow.addEventListener('click', () => {
        const first = grid.children[0] as HTMLElement | undefined;
        if (!first) return;
        const gap = parseFloat(getComputedStyle(grid).columnGap || '0');
        const step = first.offsetWidth + gap;
        const atEnd = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 2;
        if (atEnd) {
          grid.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          grid.scrollBy({ left: step, behavior: 'smooth' });
        }
      });
    }
  </script>

  <!-- Why we do this -->
  <section class="why">
    <svg class="why-wave why-wave-top" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,60 C220,4 420,4 640,52 C880,104 1080,104 1280,54 C1350,36 1400,40 1440,50 L1440,0 L0,0 Z" fill="var(--color-bg)" />
    </svg>
    <div class="why-inner">
      <h2 class="why-title">{t('home.whyTitle')}</h2>
      <p class="prose why-body">{t('home.whyBody')}</p>
    </div>
    <svg class="why-wave why-wave-bottom" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,70 C220,126 420,126 640,78 C880,26 1080,26 1280,76 C1350,94 1400,90 1440,80 L1440,120 L0,120 Z" fill="var(--color-bg)" />
    </svg>
  </section>

  <!-- Partner logos -->
  <section class="logos">
    <div class="logos-inner">
      {partnerLogos.map((src) => <img src={src} alt="Registry partner" />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero ---------------------------------------------------------------- */
  .hero {
    position: relative;
    min-height: clamp(540px, 62vw, 900px);
    background: var(--color-bg);
    overflow: hidden;
  }

  .hero-cats {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 3;
    width: clamp(560px, 70vw, 1240px);
    height: auto;
    pointer-events: none;
    transform: translateY(clamp(24px, 4vw, 80px));
  }

  .hero-title {
    position: relative;
    z-index: 2;
    padding: clamp(150px, 19vw, 250px) var(--page-pad) 0;
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(46px, 8vw, 96px);
    line-height: 1.04;
    color: var(--color-text-light);
  }

  /* Welcome ------------------------------------------------------------- */
  .welcome {
    background: var(--color-band);
    padding: clamp(56px, 7vw, 96px) var(--page-pad);
  }

  .welcome-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .welcome-photo img {
    width: 100%;
    border-radius: 6px;
  }

  .welcome-eyebrow {
    font-size: clamp(20px, 2.2vw, 32px);
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .welcome-title {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(38px, 6vw, 96px);
    line-height: 1.02;
    color: var(--color-title-soft);
    margin-bottom: clamp(20px, 2.5vw, 34px);
  }

  .welcome-body {
    text-align: justify;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  /* Kittens ------------------------------------------------------------- */
  .kittens {
    position: relative;
    background: var(--color-bg);
    padding: clamp(56px, 7vw, 100px) var(--page-pad);
    overflow: hidden;
  }

  .kittens-title {
    margin-bottom: clamp(36px, 4.5vw, 60px);
  }

  .kittens-row {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 40px);
  }

  .kittens-grid {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - clamp(32px, 5vw, 80px)) / 3);
    gap: clamp(16px, 2.5vw, 40px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .kittens-grid::-webkit-scrollbar { display: none; }

  /* ≤ 3 隻時不需 carousel，置中以免單張照片孤伶伶卡左邊 */
  .kittens-grid[data-count="1"] {
    grid-auto-columns: min(374px, 100%);
    justify-content: center;
    overflow: visible;
  }
  .kittens-grid[data-count="2"] {
    grid-auto-columns: min(calc((800px - clamp(16px, 2.5vw, 40px)) / 2), calc((100% - clamp(16px, 2.5vw, 40px)) / 2));
    justify-content: center;
    overflow: visible;
  }
  .kittens-grid[data-count="3"] { overflow: visible; }

  .kittens-grid > img {
    width: 100%;
    aspect-ratio: 374 / 408;
    object-fit: cover;
    border-radius: 6px;
    scroll-snap-align: start;
  }

  .kittens-arrow {
    flex-shrink: 0;
    width: clamp(80px, 10vw, 140px);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0.95;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .kittens-arrow:hover { transform: translateX(4px); }
  .kittens-arrow:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .kittens-arrow img {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
  }

  .kittens-cta {
    text-align: center;
    margin-top: clamp(36px, 4vw, 56px);
  }

  /* Why ----------------------------------------------------------------- */
  .why {
    position: relative;
    background: var(--color-band-soft);
    padding: clamp(90px, 11vw, 150px) var(--page-pad);
  }

  .why-wave {
    position: absolute;
    left: 0;
    width: 100%;
    height: clamp(60px, 8vw, 120px);
    display: block;
  }
  .why-wave-top {
    top: -1px;
  }
  .why-wave-bottom {
    bottom: -1px;
  }

  .why-inner {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
  }

  .why-title {
    font-family: var(--font-brand);
    font-weight: normal;
    font-size: clamp(34px, 5vw, 64px);
    color: var(--color-text-light);
    margin-bottom: clamp(22px, 3vw, 38px);
  }

  .why-body {
    text-align: justify;
  }

  /* Partner logos ------------------------------------------------------- */
  .logos {
    background: var(--color-bg);
    padding: clamp(48px, 6vw, 80px) var(--page-pad);
  }

  .logos-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
    flex-wrap: wrap;
  }

  .logos-inner img {
    max-height: clamp(70px, 9vw, 120px);
    width: auto;
    object-fit: contain;
  }

  /* Responsive ---------------------------------------------------------- */
  @media (max-width: 860px) {
    .welcome-inner {
      grid-template-columns: 1fr;
    }
    .kittens-grid {
      grid-auto-columns: 80%;
    }
    .kittens-arrow {
      display: none;
    }
    .logos-inner {
      justify-content: center;
    }
  }
</style>
