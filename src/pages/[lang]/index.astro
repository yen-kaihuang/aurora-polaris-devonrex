---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('site.name')}>
  <!-- Hero -->
  <section class="hero">
    <img src="/images/home/hero.jpg" alt="Aurora Polaris Devon Rex cats" class="hero-img" />
    <div class="hero-text">
      <h1>Aurora Polaris<br />Devon Rex</h1>
    </div>
  </section>

  <!-- Welcome：「Welcome to」浮在淺色間隔，深色區塊在下方 -->
  <div class="welcome-zone">
    <p class="welcome-label">{t('home.welcomeLabel')}</p>
    <section class="welcome">
      <div class="welcome-inner">
        <div class="welcome-photo">
          <img src="/images/home/welcome-cat.jpg" alt="Devon Rex cat" />
        </div>
        <div class="welcome-content">
          <h2 class="welcome-title">{t('home.welcomeTitle')}</h2>
          <div class="welcome-body">
            {t('home.welcomeBody').split('\n\n').map((para: string) => (
              <p>{para}</p>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Kittens Gallery -->
  <section class="kittens">
    <h2 class="kittens-title">{t('home.kittensTitle')}</h2>
    <div class="kittens-grid">
      <img src="/images/home/kitten-1.jpg" alt="Available Devon Rex kitten" />
      <img src="/images/home/kitten-2.jpg" alt="Available Devon Rex kitten" />
      <img src="/images/home/kitten-3.jpg" alt="Available Devon Rex kitten" />
    </div>
  </section>

  <!-- Why Section -->
  <section class="why">
    <img src="/images/home/wave-bg.svg" alt="" class="why-wave-top" aria-hidden="true" />
    <div class="why-inner">
      <h2 class="why-title">{t('home.whyTitle')}</h2>
      <p class="why-body">{t('home.whyBody')}</p>
    </div>
    <img src="/images/home/wave-divider.svg" alt="" class="why-wave-bottom" aria-hidden="true" />
  </section>

  <!-- Partner Logos -->
  <section class="logos-section">
    <div class="logos-inner">
      <img src="/images/home/logo-tica.png" alt="TICA" />
      <img src="/images/home/logo-trupanion.png" alt="Trupanion" />
      <img src="/images/home/logo-petsecure-1.png" alt="PetSecure" />
      <img src="/images/home/logo-petsecure-2.png" alt="PetSecure" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 65vh;
    min-height: 500px;
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    right: 0;
    top: 0;
    width: 92%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .hero-text {
    position: absolute;
    top: 22%;
    left: 10%;
    max-width: 480px;
    z-index: 1;
  }

  .hero-text h1 {
    font-family: var(--font-brand);
    font-size: clamp(48px, 6.7vw, 96px);
    color: var(--color-text-light);
    line-height: 1.05;
  }

  /* Welcome zone - 淺色間隔 + 深色區塊 */
  .welcome-zone {
    background-color: var(--color-bg);
  }

  .welcome-label {
    font-size: clamp(20px, 2vw, 28px);
    color: var(--color-text);
    text-align: right;
    padding: 32px 80px 0;
  }

  .welcome {
    background-color: var(--color-bg-dark);
    padding: 80px 64px;
  }

  .welcome-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .welcome-photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .welcome-title {
    font-size: clamp(32px, 4.5vw, 60px);
    color: var(--color-bg);
    line-height: 1.1;
    margin-bottom: 28px;
  }

  .welcome-body {
    font-size: 17px;
    color: var(--color-text);
    line-height: 1.75;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Kittens */
  .kittens {
    padding: 80px 64px;
    background-color: var(--color-bg);
  }

  .kittens-title {
    text-align: center;
    font-size: clamp(24px, 3.5vw, 48px);
    color: var(--color-text);
    margin-bottom: 48px;
  }

  .kittens-grid {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .kittens-grid img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* Why */
  .why {
    background-color: var(--color-bg-accent);
    text-align: center;
  }

  .why-wave-top,
  .why-wave-bottom {
    width: 100%;
    display: block;
  }

  .why-inner {
    padding: 48px 80px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .why-title {
    font-size: clamp(32px, 4.5vw, 60px);
    color: var(--color-text-light);
    margin-bottom: 28px;
  }

  .why-body {
    font-size: 17px;
    color: var(--color-text);
    line-height: 1.8;
    max-width: 880px;
    margin: 0 auto;
  }

  /* Partner Logos */
  .logos-section {
    background-color: var(--color-bg);
    padding: 60px 80px;
  }

  .logos-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 56px;
    flex-wrap: wrap;
    max-width: 1000px;
    margin: 0 auto;
  }

  .logos-inner img {
    max-height: 100px;
    max-width: 240px;
    width: auto;
    object-fit: contain;
  }
</style>
