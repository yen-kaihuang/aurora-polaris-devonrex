---
import LitterPage from '../../../components/LitterPage.astro';
import { litter2024 } from '../../../data/litter2024';
import type { Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
---

<LitterPage lang={lang} year={2024} kittens={litter2024} imgBase="/images/d/l2024" />
