---
import LitterPage from '../../../components/LitterPage.astro';
import { litter2022 } from '../../../data/litter2022';
import type { Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
---

<LitterPage lang={lang} year={2022} kittens={litter2022} imgBase="/images/d/l2022" />
