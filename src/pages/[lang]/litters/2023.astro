---
import LitterPage from '../../../components/LitterPage.astro';
import { litter2023 } from '../../../data/litter2023';
import type { Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
---

<LitterPage lang={lang} year={2023} kittens={litter2023} imgBase="/images/d/l2023" />
